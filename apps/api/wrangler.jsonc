{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dungeon-hunter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  // Secrets (SUPABASE_URL, SUPABASE_SECRET_KEY) live in .dev.vars locally and Wrangler secrets in prod.
  "vars": {
    "WEB_ORIGIN": "http://localhost:5173",
  },
  "env": {
    // Deploy: wrangler deploy --env production. Replace PUBLIC_HOST / PUBLIC_ZONE first (docs/launch-checklist.md).
    // /api/* is served on the same site as the web app, so the SameSite=Lax cookies work.
    "production": {
      "name": "dungeon-hunter-api",
      "routes": [{ "pattern": "PUBLIC_HOST/api/*", "zone_name": "PUBLIC_ZONE" }],
      // Must equal the real site origin exactly, or auth cookies silently break.
      "vars": { "WEB_ORIGIN": "https://PUBLIC_HOST" },
    },
  },
}
