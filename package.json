{
  "name": "dungeon-hunter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run --parallel --filter @dh/web --filter @dh/api dev",
    "prepare": "vp config",
    "db:link": "supabase link",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/db.types.ts",
    "db:check-rls": "node --env-file=apps/api/.dev.vars apps/api/scripts/check-rls.ts"
  },
  "devDependencies": {
    "supabase": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
